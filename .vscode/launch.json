{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NeRF: 训练 (tiny 冒烟, demo_scene 开箱即跑)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/projects/nerf/run_nerf.py",
      "args": [
        "--config",
        "data/demo_scene",
        "--mode",
        "train",
        "--exp",
        "demo_smoke",
        "--tiny",
        "--steps",
        "80"
      ],
      "cwd": "${workspaceFolder}/projects/nerf",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NeRF: 全局测试（pytest 全套件 15 项）",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "projects/nerf/tests",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NeRF: 单点测试（当前文件 + 测试名过滤）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": [
        "${input:testFilter}"
      ],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NeRF: 训练 (全量, 需先下载 lego 数据)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/projects/nerf/run_nerf.py",
      "args": [
        "--config",
        "data/lego",
        "--mode",
        "train",
        "--exp",
        "lego_full",
        "--steps",
        "200000"
      ],
      "cwd": "${workspaceFolder}/projects/nerf",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NeRF: 测试 (PSNR/SSIM, 需 lego 全量训练产物)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/projects/nerf/run_nerf.py",
      "args": [
        "--config",
        "data/lego",
        "--mode",
        "test",
        "--exp",
        "lego_full",
        "--ckpt",
        "logs/lego_full/latest.pt"
      ],
      "cwd": "${workspaceFolder}/projects/nerf",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NeRF: 渲染相机轨迹 (需 lego 全量训练产物)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/projects/nerf/run_nerf.py",
      "args": [
        "--config",
        "data/lego",
        "--mode",
        "render",
        "--exp",
        "lego_full",
        "--ckpt",
        "logs/lego_full/latest.pt",
        "--frames",
        "120"
      ],
      "cwd": "${workspaceFolder}/projects/nerf",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
