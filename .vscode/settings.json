{
  // ===== Python 环境（Anaconda / conda）=====
  // 项目完全用 VS Code 开发与测试（见 .vscode/SETUP.md）；conda 环境 llm_env（/home/dzxu/anaconda3/envs/llm_env）
  // 已含 torch 2.11.0+cu130 / numpy 2.2.6 / pytest 9.1.1 / pypdf；清单见根目录 environment.yml
  "python.defaultInterpreterPath": "/home/dzxu/anaconda3/envs/llm_env/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.analysis.extraPaths": ["${workspaceFolder}/projects/nerf", "${workspaceFolder}/projects/slam"],
  "python.analysis.typeCheckingMode": "basic",

  // ===== 测试 =====
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["projects/nerf/tests", "projects/slam/tests"],
  "python.testing.cwd": "${workspaceFolder}",

  // ===== 终端 =====
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/projects/nerf:${workspaceFolder}/projects/slam"
  },

  // ===== 代码质量 =====
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.rulers": [88]
  },

  // ===== 资源目录（默认折叠/隐藏，避免干扰浏览）=====
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "papers/nerf/latex/figs/**": true
  }
}
